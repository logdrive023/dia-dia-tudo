{
  "name": "dia-dia-tudo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:rapido": "vitest run --exclude \"**/*.test.tsx\" --exclude \"**/node_modules/**\" --exclude \"caos/**\"",
    "test:mudou": "vitest run --changed",
    "tipos": "tsc -b",
    "tipos:vigiar": "tsc -b --watch --preserveWatchOutput",
    "tipos:zerar": "tsc -b --clean",
    "test:caos": "vitest run --config vitest.caos.config.ts",
    "test:ponta": "vitest run --config vitest.ponta.config.ts",
    "validar": "node scripts/validar.mjs",
    "validar:plano": "node scripts/validar.mjs --plano",
    "validar:tudo": "node scripts/validar.mjs --nivel 3",
    "responsivo": "node scripts/responsivo.mjs",
    "diagnostico": "node scripts/diagnostico.mjs",
    "primeiro-acesso": "node scripts/primeiro-acesso.mjs",
    "responsivo:fotos": "node scripts/responsivo.mjs --fotos"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.13.12",
    "dexie": "4.0.10",
    "jsqr": "1.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "fake-indexeddb": "6.0.0",
    "jsdom": "25.0.1",
    "playwright-core": "1.49.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  }
}
