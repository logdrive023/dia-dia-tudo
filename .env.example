# Onde os dados ficam: memory | local | api   (padrão: local)
VITE_STORAGE=local
# Só quando VITE_STORAGE=api
VITE_API_URL=https://api.exemplo.com
# Opcional (recomendado com API): chave pública FIXA do servidor (ECDSA P-256, formato raw, base64).
# Com ela o app só aceita o aperto de mão assinado pelo servidor certo (barra alguém no meio trocando as chaves).
VITE_API_CHAVE_PUBLICA=
